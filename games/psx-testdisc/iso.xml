<?xml version="1.0" encoding="utf-8"?>
<!--
	mkpsxiso config for the LWX PSX Test Disc CD image (CC0, original
	content -- see main.c and README.md). Modeled on PSn00bSDK's own
	template iso.xml (see the SDK's share/psn00bsdk/template/iso.xml).
	No license file is included (softmod/emulator boot doesn't need one,
	and PSn00bSDK doesn't ship region license data for obvious reasons).
-->
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="LWX_PSX_TESTDISC"
			volume_set		="LWX_PSX_TESTDISC"
			publisher		="LIBRETROWEBXR"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
			copyright		="README.TXT;1"
		/>

		<directory_tree>
			<file name="SYSTEM.CNF"	type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="PSXTEST.EXE"	type="data" source="psxtest.exe" />

			<dummy sectors="32"/>
		</directory_tree>
	</track>
</iso_project>
